{
  "name": "playnix-sdk",
  "version": "1.0.0",
  "description": "Type-safe SDK for the Playnix Mini App: REST client, Telegram Mini App helpers, initData validation, webhook handler and Stars subscriptions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/esm/server/index.d.ts",
        "default": "./dist/esm/server/index.js"
      },
      "require": {
        "types": "./dist/cjs/server/index.d.ts",
        "default": "./dist/cjs/server/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "playnix",
    "telegram",
    "mini-app",
    "telegram-stars",
    "sdk",
    "typescript",
    "games"
  ],
  "devDependencies": {
    "@types/node": "^22.18.12",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmedbecett/PlaynixGames.git",
    "directory": "sdk"
  },
  "homepage": "https://playnix-ashen.vercel.app",
  "bugs": {
    "url": "https://github.com/Ahmedbecett/PlaynixGames/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "server": [
        "dist/esm/server/index.d.ts"
      ],
      "*": [
        "dist/esm/index.d.ts"
      ]
    }
  }
}
