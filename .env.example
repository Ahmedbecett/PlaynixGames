# --- Playnix environment template (copy to .env.local) ---
# PUBLIC APP URL (Vercel domain or tunnel). No trailing slash.
# Used for canonical URLs, sitemap.xml, robots.txt and link previews.
# On Vercel this can be left empty: the production domain is detected
# automatically from VERCEL_PROJECT_PRODUCTION_URL.
# MUST be set BEFORE `npm run build` (NEXT_PUBLIC_* values are inlined).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Search Console — optional "HTML tag" verification token from
# https://search.google.com/search-console (Settings → Ownership verification).
# The HTML file method (public/google*.html) works too and needs no variable.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Telegram bot (BotFather). NEVER commit real values.
TELEGRAM_BOT_TOKEN=
# Your bot's username without the @ (needed for t.me deep links + share).
# Set it BEFORE `npm run build`: NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Random string used to verify X-Telegram-Bot-Api-Secret-Token on the webhook
TELEGRAM_WEBHOOK_SECRET=

# 32+ char random string used to sign session cookies
SESSION_SECRET=
# Comma separated Telegram IDs that get the admin role on first login
ADMIN_TELEGRAM_IDS=

# Database: leave DATABASE_URL empty to use the local SQLite file (dev only).
# Production: postgres://user:pass@host:5432/playnix?sslmode=require
DATABASE_URL=
SQLITE_PATH=./data/playnix.db

# Dev convenience: allow signing in outside Telegram with a local preview account.
# MUST be false in production.
ALLOW_DEV_LOGIN=true

# Object storage for admin image uploads (production). When unset, uploads are
# written to ./public/uploads (development only, read-only on Vercel).
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Rewarded ads (Monetag). Leave NEXT_PUBLIC_ADS_ENABLED unset to keep ads off:
# the UI hides every ad surface and no third-party host is added to the CSP.
NEXT_PUBLIC_ADS_ENABLED=
NEXT_PUBLIC_ADS_ZONE_ID=
NEXT_PUBLIC_ADS_SDK_URL=https://libtl.com/sdk.js
# Rewarded popup as a fallback when the interstitial errors
NEXT_PUBLIC_ADS_POPUP_FALLBACK=true
# Automatic in-app interstitials (off by default — rewarded ads are the main surface)
NEXT_PUBLIC_ADS_INAPP_ENABLED=false
NEXT_PUBLIC_ADS_INAPP_FREQUENCY=1
NEXT_PUBLIC_ADS_INAPP_CAPPING_HOURS=0.1
NEXT_PUBLIC_ADS_INAPP_INTERVAL=30
NEXT_PUBLIC_ADS_INAPP_TIMEOUT=5
NEXT_PUBLIC_ADS_INAPP_EVERY_PAGE=true
# Server-only policy for the rewarded unlock
ADS_REWARD_MINUTES=20
ADS_DAILY_LIMIT=3
ADS_COOLDOWN_SECONDS=45
