{
  "name": "playnix",
  "version": "1.0.0",
  "private": true,
  "description": "Playnix — Telegram gaming search engine & instant-play Mini App",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "prebuild": "npm run sdk:build && tsx --env-file-if-exists=.env.local scripts/ensure-db.ts && tsx --env-file-if-exists=.env.local scripts/ensure-bot.ts",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "npm run sdk:build && tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/db-seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/db-reset.ts",
    "bot:poll": "tsx --env-file-if-exists=.env.local scripts/bot-poll.ts",
    "bot:webhook": "tsx --env-file-if-exists=.env.local scripts/set-webhook.ts",
    "smoke": "tsx --env-file-if-exists=.env.local scripts/smoke-test.ts",
    "logo:png": "node scripts/logo-png.mjs",
    "verify:games": "tsx --env-file-if-exists=.env.local scripts/verify-games.ts",
    "covers": "node scripts/gen-covers.mjs",
    "welcome": "node scripts/gen-welcome.mjs",
    "games:check": "node scripts/check-games.mjs",
    "bot:check": "tsx scripts/check-bot.ts",
    "sdk:build": "cd sdk && npm run build",
    "sdk:test": "cd sdk && npm test",
    "sdk:typecheck": "cd sdk && npm run typecheck",
    "sdk:check": "tsx scripts/check-sdk.ts",
    "ads:check": "tsx scripts/check-ads.ts"
  },
  "dependencies": {
    "next": "15.5.29",
    "pg": "8.16.3",
    "playnix-sdk": "file:sdk",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.18.12",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "^26.1.0",
    "sharp": "0.34.4",
    "tailwindcss": "4.1.17",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.5"
  }
}
